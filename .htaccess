# Root rules for Laravel when the hosting document root points at the project.
# Keep the application source private and serve requests through /public.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny hidden files and directories, except the standard ACME/.well-known path.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

    # Deny Laravel source directories and sensitive project files if the project
    # root is exposed as the web document root.
    RewriteRule (^|/)(app|bootstrap|config|database|resources|routes|tests|vendor|\.git|\.github)(/|$) - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs)(/|$) - [F,L,NC]
    RewriteRule (^|/)(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|vite\.config\.[^/]+)(/|$) - [F,L,NC]

    # Reject methods that have no valid use for this website.
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG)$ [NC]
    RewriteRule ^ - [F,L]

    # Reject common vulnerability scanners. This is a filter for known tools,
    # not a replacement for authentication or rate limiting.
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|havij|acunetix|wpscan|masscan|zgrab|nmap|nessus|openvas|dirbuster|gobuster|jbrofuzz|pangolin|cgiscan) [NC]
    RewriteRule ^ - [F,L]

    # Deny common private, backup, and executable-support file types. JSON is
    # intentionally allowed because public endpoints or assets may use it.
    RewriteRule \.(env|ya?ml|lock|sql|sqlite|log|sh|bak|backup|old|orig|swp|dist|ini|conf|inc|pem|key|crt|tar|gz|zip|md)$ - [F,L,NC]

    # Remove the implementation directory from old or manually copied URLs.
    RewriteRule ^public/(.*)$ /$1 [R=301,L,NE]

    # Stop internal rewrites from being applied more than once.
    RewriteRule ^public/ - [L]

    # Route requests through Laravel's public directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
