# ==============================================================================
# Recovery Data CMS - Root Directory Security Rules
# Prevents unauthorized access if document root is misconfigured to root folder
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to sensitive configuration, database, and repository files
    RewriteRule ^(\.env|\.git|\.github|composer\.|package\.|artisan|database/|storage/logs/|storage/framework/|app/|bootstrap/|config/|resources/|routes/|vendor/) - [F,L,NC]

    # 2. Prevent access to files with sensitive extensions
    RewriteRule \.(env|yml|yaml|json|lock|sql|sqlite|log|sh|bak|swp|dist|md)$ - [F,L,NC]

    # Remove the implementation directory from legacy or manually copied URLs.
    RewriteRule ^public/(.*)$ /$1 [R=301,L,NE]

    # 3. Route all legitimate web traffic into the /public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes
